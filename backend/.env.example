# Copy to backend/.env and fill in. Never commit .env — the API key must stay private.

# Key from https://pdp-api.plk-sa.pl (sent by e-mail after the application is approved)
PLK_API_KEY=

# basic | standard | premium — controls the default polling interval and quota budget
PLK_TIER=basic

# Comma-separated carrier codes passed as carriersInclude (IC = PKP Intercity)
CARRIERS=IC

# Optional override of the /operations polling interval in seconds (clamped to the tier's daily budget)
POLL_INTERVAL_S=

# 1 = run without a key using synthetic trains on real stations (for development)
MOCK_MODE=0

# Timezone attached to the API's naive timestamps
PLK_NAIVE_TZ=Europe/Warsaw

# Comma-separated origins allowed by CORS (the Vite dev server proxies /api, so this is only for direct access)
CORS_ORIGINS=http://localhost:5173
